# Exclude files from GCP deployment
.git
.gitignore
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
build
.pytest_cache
.coverage
htmlcov
.tox
# B-96-2: the FULL secret/local class — `.env` alone missed `.env.local` /
# `.env.production`, which Git ignores (invisible to `git status --porcelain`)
# yet the upload and `COPY . .` would include. Pattern class, not one name.
.env*
*.db
*.sqlite*
*.log
.venv
venv/
ENV/
tests/
docs/
examples/
*.md
!README.md
.DS_Store
*.swp
*.swo
node_modules/
